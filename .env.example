# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin panel login (http://localhost:3000/admin)
ADMIN_PASSWORD=change-me-before-sunday
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Optional — leave blank until credentials exist; APIs will no-op / explain
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=R-SPLM People First

DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_CALLBACK_URL=https://your-domain.com/api/donate/mpesa/callback
DARAJA_ENV=sandbox
