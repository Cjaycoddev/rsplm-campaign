# Copy into Vercel → Settings → Environment Variables (Production)
# Do not commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key

# Admin (https://your-app.vercel.app/admin/login)
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=long-random-string

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=R-SPLM People First

# Local = sandbox. Vercel can also stay sandbox until Go Live.

